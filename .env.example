MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/med_super_app?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PATIENT_DATA_AES_KEY=replace-with-a-base64-encoded-random-32-byte-key
PATIENT_LOOKUP_HMAC_KEY=replace-with-a-different-base64-encoded-random-32-byte-key
PATIENT_DATA_MIGRATE_LEGACY_ON_STARTUP=false
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FIREBASE_PROJECT_ID=medappsms
# Absolute path on the machine that runs the backend. Do not commit this JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\medappsms-firebase-adminsdk.json
SMS_GATEWAY_REGISTRATION_KEY=replace-with-a-long-random-secret-for-the-Android-gateway
# For local multi-backend testing only: the FCM token shown by the Android gateway app.
SMS_GATEWAY_DIRECT_FCM_TOKEN=
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Used to create an ADMIN account when this phone number does not exist.
BOOTSTRAP_ADMIN_PHONE_NUMBER=0912345678
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
